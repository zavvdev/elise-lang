.schema(
    .dict(
        "case1" .list(.union(
                        .string(),
                        .float()))
        
        "case2" .list(.union(
                        .list(.string()),
                        .list(.int())))
        
        "case3" .list(.union(
                        .list(.dict(
                                "some"  .int()
                                "some2" .float()
                        )),
                        .list(.dict(
                                "some3" .string()
                                "some"  .list(.int())
                        ))))

        "case4"  .list(.union(
                         .float()
                         .float()))
    )
)

