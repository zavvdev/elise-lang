.typedef (Address :Dict{
                       "country" :String
                       "city"    :String
                       "street"  :String? })

.typedef (User :Dict{
                    "id"      :Int
                    "name"    :String
                    "emails"  :List<String>?
                    "address" :Address|Null })

.typedef (Data :List<User>)

// .elt file must contain Data type definition.
// Only type definitions are allowed here.
// Each defined type with .typedef function will be 
// injected into .eli source code global scope.
