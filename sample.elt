.schema(
    .dict(
        "case1" .list(.union(
                        .string(),
                        .float()))
        
        "case2" .list(.union(
                        .list(.string()),
                        .list(.int())))
        
        "case3" .list(.union(
                        .list(.dict(
                                "some"  .int()
                                "some2" .float()
                        )),
                        .list(.dict(
                                "some3" .string()
                                "some"  .list(.int())
                        ))))

        "case4"  .list(.union(
                         .float()
                         .float()))
    )
)

[Root] -> Dict

[Root, "case1"] -> ListAbstract
[Root, "case1", AbstractIndex] -> Assertable<String, Float>

vec![Root, "case1", AbstractIndex, String]
vec![Root, "case1", AbstractIndex, Float] 

intersect = vec![Root, "case1", AbstractIndex]

[Root, "case1", AbstractIndex, Assertion(String)] -> String
[Root, "case1", AbstractIndex, Assertion(Float)] -> Float

