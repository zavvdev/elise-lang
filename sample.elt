.typedef (Address :Record<{
                       "country" :Str
                       "city"    :Str
                       "street"  :Optional<:Str> }>)

.typedef (User :Record<{
                    "id"      :Int
                    "name"    :Str
                    "emails"  :List<:Str>
                    "address" :Nullable<:Address> }>)

.typedef (Data :List<:User>)
