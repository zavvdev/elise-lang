.schema(
    .dict(
        "case1" .list(.union(
                        .string(),
                        .float()))
        "case2" .list(.union(
                        .list(.string()),
                        .list(.int())))
        "case3" .list(.union(
                        .list(.dict(
                                "some"  .int()
                                "some2" .float()
                        )),
                        .list(.dict(
                                "some3" .string()
                                "some"  .list(.int())
                        ))))
    )
)

[Root] -> Dict

[Root, "case1"] -> ListAbstract
[Root, "case1", AbstractIndex] -> Assertable<String, Float>

vec![Root, "case1", AbstractIndex, String]
vec![Root, "case1", AbstractIndex, Float] 

intersect = vec![Root, "case1", AbstractIndex]

[Root, "case1", AbstractIndex, Assertion(String)] -> String
[Root, "case1", AbstractIndex, Assertion(Float)] -> Float

------------------

[Root] -> Dict

[Root, "case2"] -> ListAbstract

vec![Root, "case2", AbstractIndex, AbstractIndex, String]
vec![Root, "case2", AbstractIndex, AbstractIndex, Int] 

intersect = vec![Root, "case2", AbstractIndex, AbstractIndex]

[Root, "case2", AbstractIndex, AbstractIndex] -> Assertable<String, Int>
[Root, "case2", AbstractIndex, AbstractIndex, Assertion(String)] -> String
[Root, "case2", AbstractIndex, AbstractIndex, Assertion(Int)] -> Int

------------------

[Root] -> Dict

[Root, "case3"] -> ListAbstract

vec![
    (Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some"), Int),
    (Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some2"), Float)
]
vec![
    (Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some3"), String)
    (Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some"), List)
]

intersect = vec![
    (Root, "case3", AbstractIndex, AbstractIndex, Dict),
    (Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some")),
    (Root, "case3", AbstractIndex, AbstractIndex, Dict),
    (Root, "case3", AbstractIndex, AbstractIndex, Dict),
].filter(duplicates)

We might now event need next stuff, but we can just slice by each intersection and get next node and
construct: [Root, "case3", AbstractIndex, AbstractIndex, Dict] -> Assertable<Field("some"), Field("some3"), Field("some2")>. 
Same for path with Field("some").

[Root, "case3", AbstractIndex, AbstractIndex, Dict] -> Assertable<Field("some"), Field("some3")>
[Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some")] -> Assertable<Float, List>
[Root, "case3", AbstractIndex, AbstractIndex, Dict] -> Assertable<Field("some2"), Field("some3")>
[Root, "case3", AbstractIndex, AbstractIndex, Dict] -> Assertable<Field("some2"), Field("some")>

Collapses into:

[Root, "case3", AbstractIndex, AbstractIndex, Dict] -> Assertable<Field("some"), Field("some3"), Field("some2")>
[Root, "case3", AbstractIndex, AbstractIndex, Dict, Field("some")] -> Assertable<Float, List>
